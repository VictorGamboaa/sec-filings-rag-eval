# Credentials — never commit (CLAUDE.md, mandatory)
.env

# Environments and agent state (CLAUDE.md, mandatory)
.venv/
.claude

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Build artifacts: run logs, indexes, intermediates.
# Structure is preserved via .gitkeep; contents are not tracked.
outputs/*
!outputs/.gitkeep
temp/*
!temp/.gitkeep

# One-off scripts and probes. Kept out of tools/ and the project root so that
# tools/ stays the deterministic, tested layer the workflows depend on.
scratch/*
!scratch/.gitkeep

# Model caches
.cache/
scratch/
*.bak*
