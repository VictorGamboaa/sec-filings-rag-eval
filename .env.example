# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- SEC EDGAR ---------------------------------------------------------------
# REQUIRED. The SEC mandates a declared User-Agent identifying the requester,
# in the form "Name email@domain". Requests without it are refused (403).
# See https://www.sec.gov/os/webmaster-faq#developers
EDGAR_USER_AGENT="Your Name your.email@example.com"

# --- Hosted embedding providers ----------------------------------------------
# NOT IMPLEMENTED. The embedder interface in tools/embedders/base.py defines the
# seam these would plug into; no hosted implementation exists yet. Listed here so
# the required key # --- Hosted embedding providers ---
# voyage-finance-2 is implemented in tools/embedders/voyage.py. Set VOYAGE_API_KEY
# to reproduce the voyage results. The bge configurations run locally and need no
# key, so everything except the voyage arm works without this file.
#
# Keys are issued at voyageai.com. A full build of this corpus measured 4,443,914
# tokens; check their current pricing page for the free allowance before running.
VOYAGE_API_KEY=

# Not implemented. Listed so the required key is obvious if a provider is added
# against the seam in tools/embedders/base.py.
# OPENAI_API_KEY=is obvious when one is added.
# VOYAGE_API_KEY=
# OPENAI_API_KEY=
